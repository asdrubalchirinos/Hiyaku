---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import DraftBadge from "../components/DraftBadge.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { formatDate, getPublishedPosts, sortByDate } from "../utils/posts";
import { withBase } from "../utils/paths";

const sortedPosts = sortByDate(await getPublishedPosts());
const featuredPost = sortedPosts.find((post) => post.data.featured);
const recentPosts = sortedPosts
  .filter((post) => post !== featuredPost)
  .slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} image="/hiyaku-og.svg">
  <h1 class="visually-hidden">
    Hiyaku — blog de Bea sobre el trabajo de Growth Partner
  </h1>
  <div class="container">
    <div class="content">
      {
        featuredPost && (
          <section class="featured-post">
            <a href={withBase(`/blog/${featuredPost.id}/`)}>
              <div class="post-wrapper">
                {featuredPost.data.heroImage && (
                  <img
                    width={720}
                    height={360}
                    src={withBase(featuredPost.data.heroImage)}
                    alt=""
                  />
                )}
                <DraftBadge draft={featuredPost.data.draft} />
              </div>
              <h2 class="title">{featuredPost.data.title}</h2>
              {featuredPost.data.subtitle && (
                <p class="subtitle">{featuredPost.data.subtitle}</p>
              )}
              <p class="date">{formatDate(featuredPost.data.pubDate)}</p>
            </a>
          </section>
        )
      }

      <section class="recent-posts">
        <h3>Últimos posts</h3>
        <ul>
          {
            recentPosts.map((post) => (
              <li>
                <a href={withBase(`/blog/${post.id}/`)}>
                  <div class="post-content">
                    <h4 class="title">{post.data.title}</h4>
                    {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
                    <p class="date">{formatDate(post.data.pubDate, "short")}</p>
                  </div>
                  {post.data.heroImage && (
                    <div class="post-image">
                      <div class="image-wrapper">
                        <img
                          width={120}
                          height={120}
                          src={withBase(post.data.heroImage)}
                          alt=""
                        />
                        <DraftBadge draft={post.data.draft} />
                      </div>
                    </div>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="view-all">
          <a href={withBase("/blog/")}>Ver todos los posts →</a>
        </div>
      </section>
    </div>
    <aside>
      <Sidebar />
    </aside>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .container {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    max-width: 100%;
    overflow-x: clip;
  }
  .content {
    flex: 2;
  }
  aside {
    flex: 1;
  }
  .featured-post {
    margin-bottom: 3rem;
  }
  .featured-post .post-wrapper {
    position: relative;
  }
  .featured-post img {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  .featured-post a {
    text-decoration: none;
    color: inherit;
  }
  .featured-post .title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }
  .featured-post .subtitle {
    color: rgb(var(--gray-dark));
    font-size: 1.5rem;
    margin: 0;
  }
  .featured-post .date {
    color: rgb(var(--gray));
    margin-bottom: 1rem;
    margin-top: 0;
  }
  .recent-posts ul {
    list-style: none;
    padding: 0;
  }
  .recent-posts li {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgb(var(--gray-light));
    padding-bottom: 1.5rem;
  }
  .recent-posts li:last-child {
    border-bottom: none;
  }
  .recent-posts a {
    text-decoration: none;
    color: inherit;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .post-content {
    flex: 1;
  }
  .post-image .image-wrapper {
    position: relative;
  }
  .post-image img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }
  .recent-posts .title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }
  .recent-posts .date {
    color: rgb(var(--gray));
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
    margin-top: 0;
  }
  .recent-posts .subtitle {
    color: rgb(var(--gray-dark));
    font-size: 1rem;
    margin: 0;
  }
  .view-all {
    margin-top: 2rem;
    text-align: center;
  }
  .view-all a {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    background-color: rgb(var(--accent));
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
  }
  .view-all a:hover {
    background-color: rgb(var(--accent-dark));
    color: #fff;
  }
  @media (max-width: 768px) {
    .container {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
