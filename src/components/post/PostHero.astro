---
import DraftBadge from "../DraftBadge.astro";

interface Props {
  src?: string;
  alt: string;
  draft?: boolean;
}

const { src, alt, draft = false } = Astro.props;
---

{
  src && (
    <div class="hero-image">
      <img width={1020} height={510} src={src} alt={alt} />
      <DraftBadge draft={draft} />
    </div>
  )
}

<style>
  .hero-image {
    position: relative;
    width: 100%;
    margin-top: 2rem;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    width: 100%;
    height: auto;
  }
</style>
