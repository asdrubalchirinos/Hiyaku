---
import { SITE_AUTHOR } from "../../consts";
import { formatDate, isoDateOnly } from "../../utils/posts";

interface Props {
  title: string;
  subtitle?: string;
  author?: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, subtitle, author, pubDate, updatedDate } = Astro.props;
const byline = author || SITE_AUTHOR;
---

<header class="title">
  <div class="date">
    <time datetime={isoDateOnly(pubDate)}>{formatDate(pubDate)}</time>
    {
      updatedDate && (
        <span class="last-updated-on">
          {" "}
          · Actualizado{" "}
          <time datetime={isoDateOnly(updatedDate)}>{formatDate(updatedDate)}</time>
        </span>
      )
    }
  </div>
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <div class="meta"><span class="author">Por {byline}</span></div>
  <hr />
</header>

<style>
  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: center;
    line-height: 1;
  }
  .title h1 {
    margin: 0 0 0.5em;
  }
  .subtitle {
    font-size: 1.5em;
    color: rgb(var(--gray));
    font-weight: normal;
    margin: 0.5em 0;
    line-height: 1.3;
  }
  .date {
    margin-bottom: 0.5em;
    color: rgb(var(--gray));
  }
  .last-updated-on {
    font-style: italic;
  }
  .meta {
    margin-top: 0.75em;
    color: rgb(var(--gray));
    font-size: 0.95rem;
  }
</style>
